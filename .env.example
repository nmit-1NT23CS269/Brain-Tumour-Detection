# NeuroScan AI Environment Configuration Template
# Copy this file to .env and populate with your configuration values.

# Enable/disable one-click demonstration logins (default: false; keep false in production)
DEMO_MODE=false

# Demo Patient credentials (only active when DEMO_MODE=true)
DEMO_PATIENT_EMAIL=patient.demo@example.com
DEMO_PATIENT_PASSWORD=Patient@123

# Demo Doctor credentials (only active when DEMO_MODE=true)
DEMO_DOCTOR_EMAIL=doctor.demo@example.com
DEMO_DOCTOR_PASSWORD=Doctor@123

# Pending Demo Doctor credentials (only active when DEMO_MODE=true)
DEMO_PENDING_DOCTOR_EMAIL=pending.doctor@example.com
DEMO_PENDING_DOCTOR_PASSWORD=Doctor@123

# Demo Administrator credentials (only active when DEMO_MODE=true)
DEMO_ADMIN_EMAIL=admin.demo@example.com
DEMO_ADMIN_PASSWORD=Admin@123

# Mastishka LLM Provider Configuration (optional: anthropic | openai | gemini | ollama)
# Leave LLM_PROVIDER empty to run in offline fallback mode using local knowledge retrieval
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=20
RETRIEVAL_THRESHOLD=0.25
